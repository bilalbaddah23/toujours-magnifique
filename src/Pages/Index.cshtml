@page
@{ViewData["Title"]="The details make it personal.";ViewData["Page"]="home";}
<section class="fashion-hero"><div class="fashion-hero-copy"><span class="eyebrow">FASHION · LEBANON</span><h1>A little allure.<br/><em>Every day.</em></h1><p>Shoes that finish the look. Clothing that feels like you. Meet the seasonal edit from Toujours Magnifique in Dekwaneh.</p><a href="/shop" class="button">Find your favourite <span>↗</span></a><div class="hero-meta"><span>EXPLORE THE COLLECTION</span><span>A PERSONAL CONVERSATION</span></div></div><div class="fashion-hero-image"><img src="@Shop.Settings.Hero" alt="From the Toujours Magnifique collection" width="1080" height="1440" fetchpriority="high"/><span class="photo-label">THE TOUJOURS EDIT / 01</span></div><span class="hero-decoration" aria-hidden="true">✳</span></section>
<div class="values-strip"><span>The details make it personal.</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><a href="/lookbook">A closer look at the collection ↗</a></div>
<div class="n12-running" aria-hidden="true"><div><span>Toujours Magnifique</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Toujours Magnifique</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Toujours Magnifique</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i><span>Toujours Magnifique</span><i>✦</i><span>FASHION · LEBANON</span><i>✦</i><span>Discover · Save · Enquire</span><i>✦</i><span>Made for your own point of view</span><i>✦</i></div></div>
<section class="section first-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h2>Good looks.<br/><em>Your own way.</em></h2></div><div><p>A selection from the collection.<br/>Keep the looks you love close.</p><a href="/shop" class="text-link">Discover the whole edit ↗</a></div></div><div class="product-grid">@foreach(var p in Shop.Products.Take(4)){<partial name="_Card" model="p"/>}</div></section>
<section class="fashion-story" data-reveal><div class="fashion-story-photo"><img src="@Shop.Settings.Story" alt="A closer look at Toujours Magnifique" width="900" height="1200" loading="lazy"/></div><div class="fashion-story-copy"><span class="eyebrow">THE WORLD OF TOUJOURS</span><h2>A closer look.<br/><em>A personal choice.</em></h2><p>Toujours Magnifique is a shoes and clothing concept in Dekwaneh. Its public profile offers delivery across Lebanon and a direct WhatsApp contact. Discover the photographed collection and ask the team about the options that suit you.</p><a href="/our-world" class="button outline">Discover our world <span>↗</span></a><span class="section-number">02 / Toujours Magnifique</span></div></section>
<section class="section category-edit" data-reveal><div class="section-heading"><div><span class="eyebrow">A LITTLE DIRECTION</span><h2>What are you<br/><em>in the mood for?</em></h2></div><a href="/style-guide" class="text-link">Help me choose ↗</a></div><div class="category-grid">@foreach(var (category,i) in Shop.Products.Select(p=>p.Collection).Distinct().Take(3).Select((x,i)=>(x,i))){var p=Shop.Products.First(p=>p.Collection==category);<a href="/shop?collection=@Uri.EscapeDataString(category)"><div><img src="@p.Images[0]" alt="@category from Toujours Magnifique" width="700" height="930" loading="lazy"/></div><span>0@(i+1) / @category <b>↗</b></span></a>}</div></section>
<section class="section diary-feature" data-reveal><div><span class="eyebrow">THE VISUAL DIARY</span><h2>A detail.<br/>A different angle.<br/><em>A new favourite.</em></h2><p>Explore the collection in photographs. Follow a colour, discover a silhouette and gather your inspiration.</p><a href="/lookbook" class="button">Open the photo diary <span>↗</span></a></div><div class="diary-pair"><img src="@Shop.Products.Last().Images[0]" alt="Collection inspiration from Toujours Magnifique" width="720" height="960" loading="lazy"/><img src="@Shop.Products.Skip(1).First().Images.Last()" alt="More collection details from Toujours Magnifique" width="520" height="690" loading="lazy"/></div></section>
<section class="section shopping-steps" data-reveal><div><span class="eyebrow">MAKE IT PERSONAL</span><h2>From inspiration<br/><em>to a conversation.</em></h2></div><ol><li><span>01</span><h3>Find your favourites</h3><p>Browse the collection, explore the photographs and save the looks that speak to you.</p></li><li><span>02</span><h3>Build your selection</h3><p>Add your pieces to a bag and share your size, colour and delivery questions.</p></li><li><span>03</span><h3>Talk to the team</h3><p>Review your enquiry before sending. The boutique confirms options, availability and the final price.</p></li></ol></section>
